<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>TargetCatalogManager</RootNamespace>
    <AssemblyName>tcm</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- This csproj lives at the repo root, so any nested project would be swept into the default Compile
         glob (duplicate AssemblyInfo + unresolvable types) without these exclusions. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);TargetCatalogManager.App\**;TargetCatalogManager.App.Tests\**;TargetCatalogManager.Cli.Tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Cross-repo local ProjectReference (local disk is source of truth): the shared schema/build contract. -->
  <ItemGroup>
    <ProjectReference Include="..\Library\Astronomy.Catalog\Astronomy.Catalog.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TargetCatalogManager.Cli.Tests" />
  </ItemGroup>

</Project>
