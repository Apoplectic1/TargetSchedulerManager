<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- WinUI needs a real Windows TargetPlatformVersion (unlike net10.0-windows = 7.0 in the library);
         19041 is the lowest TPV with the full WinUI 3 surface; min 17763 matches Windows App SDK support. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>TargetCatalogManager.App</RootNamespace>
    <AssemblyName>tcmui</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Self-contained Windows App SDK (runtime ships in the output folder) needs a RID at build time;
         x64-only app, so pin it. The .NET runtime itself stays framework-dependent. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Unpackaged: builds a plain exe (run/F5 like a WinForms app), no MSIX. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" />
    <!-- Observation screenshots (Graphics.CopyFromScreen); Windows-only package, Windows-only app. -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.9" />
  </ItemGroup>

  <!-- Cross-repo local ProjectReference (local disk is source of truth): the shared schema/build contract. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Library\Astronomy.Catalog\Astronomy.Catalog.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TargetCatalogManager.App.Tests" />
  </ItemGroup>

</Project>
