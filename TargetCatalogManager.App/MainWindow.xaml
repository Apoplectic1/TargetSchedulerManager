<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TargetCatalogManager.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TargetCatalogManager.App"
    xmlns:m="using:TargetCatalogManager.App.ViewModels.Rows">

    <!-- Layout = nested panels (like WinForms TableLayoutPanel/Dock) declared in XAML.
         {x:Bind} is typed, compile-time binding: a path typo is a build error, not a silent empty cell. -->
    <!-- PlacementMode Hidden: WinUI auto-surfaces a declared accelerator as a floating "Ctrl+N" hover
         tooltip; Hidden removes that hint entirely (never created) while the accelerator keeps working. -->
    <Grid Padding="12,8,12,8" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.Resources>
            <!-- The grid's rows mix two item types (group header / filter row); the selector below picks the
                 template per item. Both templates share the header's column widths so everything lines up. -->
            <DataTemplate x:Key="GroupRowTemplate" x:DataType="m:TargetGroupRow">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="45"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <!-- Target enable (TS target.active): only on TS-backed target headers (CanEnableVisibility
                         hides it on disk-only and mosaic-parent rows). Click writes to the TS copy immediately. -->
                    <CheckBox Grid.Column="0" MinWidth="0" Padding="0"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Visibility="{x:Bind CanEnableVisibility}"
                              IsChecked="{x:Bind IsTargetEnabled}" IsThreeState="False"
                              Click="TargetEnable_Click"
                              ToolTipService.ToolTip="Enable/disable this target in Target Scheduler"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <!-- The disclosure chevron; OneWay because IsExpanded flips in place on toggle. -->
                        <FontIcon Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" FontSize="11"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind SourceText}" Opacity="0.7" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{x:Bind TargetText}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="3" Text="{x:Bind Project}" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="7" Text="{x:Bind DesiredText}" TextAlignment="Right"/>
                    <TextBlock Grid.Column="8" Text="{x:Bind AcquiredText}" TextAlignment="Right" Opacity="0.7"/>
                    <TextBlock Grid.Column="9" Text="{x:Bind AcceptedText}" TextAlignment="Right" Opacity="0.7"/>
                    <TextBlock Grid.Column="10" Text="{x:Bind DiskText}" TextAlignment="Right" FontWeight="SemiBold"/>
                    <!-- Disk hours − desired hours; caution fill = needs telescope time, green = goal met. -->
                    <Border Grid.Column="11" Background="{x:Bind HoursBackground}" CornerRadius="4"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Padding="6,1">
                        <TextBlock Text="{x:Bind HoursText}"/>
                    </Border>
                    <TextBlock Grid.Column="13" Text="{x:Bind Badge}" Margin="10,0,0,0"
                               Foreground="{ThemeResource SystemFillColorCautionBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="FilterRowTemplate" x:DataType="m:ReconciliationRow">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="45"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <!-- Column 0 (enable checkbox) is blank on filter rows. Indent ladder: mixed rollups carry
                         their own chevron; their source lines step in one more level (SourceMargin all three). -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                Margin="{x:Bind SourceMargin}">
                        <FontIcon Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" FontSize="11"
                                  VerticalAlignment="Center" Visibility="{x:Bind ChevronVisibility}"/>
                        <TextBlock Text="{x:Bind SourceText}" Opacity="0.7" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{x:Bind Target}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="3" Text="{x:Bind Project}" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="4" Text="{x:Bind Filter}"/>
                    <!-- "mixed" gets a caution pill when a rollup spans 2+ sub lengths; plain otherwise. -->
                    <Border Grid.Column="5" Background="{x:Bind SecondsBackground}" CornerRadius="4"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Padding="6,1" Margin="0,0,8,0">
                        <TextBlock Text="{x:Bind SecondsText}"/>
                    </Border>
                    <TextBlock Grid.Column="6" Text="{x:Bind Purpose}" Opacity="0.7"/>
                    <TextBlock Grid.Column="7" Text="{x:Bind DesiredText}" TextAlignment="Right"/>
                    <TextBlock Grid.Column="8" Text="{x:Bind AcquiredText}" TextAlignment="Right" Opacity="0.7"/>
                    <TextBlock Grid.Column="9" Text="{x:Bind AcceptedText}" TextAlignment="Right" Opacity="0.7"/>
                    <TextBlock Grid.Column="10" Text="{x:Bind DiskText}" TextAlignment="Right"
                               FontWeight="SemiBold"/>
                    <!-- One-plane rows: plain hours. Both rows: disk − desired gap, caution/green fill. -->
                    <Border Grid.Column="11" Background="{x:Bind HoursBackground}" CornerRadius="4"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Padding="6,1">
                        <TextBlock Text="{x:Bind HoursText}"/>
                    </Border>
                    <TextBlock Grid.Column="12" Text="{x:Bind PlanCountText}" TextAlignment="Right" Opacity="0.7"/>
                    <TextBlock Grid.Column="13" Text="{x:Bind Badge}" Margin="10,0,0,0"
                               Foreground="{ThemeResource SystemFillColorCautionBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </DataTemplate>
            <!-- A mosaic panel's mini-header: the group template's shape, indented one step, showing the
                 panel's own source/aggregates. Click toggles its filter rows like a target group. -->
            <DataTemplate x:Key="PanelRowTemplate" x:DataType="m:PanelGroupRow">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="45"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <!-- Column 0 (enable checkbox) is blank on panel rows; the 18px panel indent lives in column 1. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="18,0,0,0">
                        <FontIcon Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" FontSize="11"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind SourceText}" Opacity="0.7" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{x:Bind Label}" Opacity="0.9"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="7" Text="{x:Bind DesiredText}" TextAlignment="Right"/>
                    <TextBlock Grid.Column="8" Text="{x:Bind AcquiredText}" TextAlignment="Right" Opacity="0.7"/>
                    <TextBlock Grid.Column="9" Text="{x:Bind AcceptedText}" TextAlignment="Right" Opacity="0.7"/>
                    <TextBlock Grid.Column="10" Text="{x:Bind DiskText}" TextAlignment="Right" FontWeight="SemiBold"/>
                    <Border Grid.Column="11" Background="{x:Bind HoursBackground}" CornerRadius="4"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Padding="6,1">
                        <TextBlock Text="{x:Bind HoursText}"/>
                    </Border>
                    <TextBlock Grid.Column="13" Text="{x:Bind Badge}" Margin="10,0,0,0"
                               Foreground="{ThemeResource SystemFillColorCautionBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </DataTemplate>
            <local:RowTemplateSelector x:Key="RowTemplateSelector"
                                       GroupTemplate="{StaticResource GroupRowTemplate}"
                                       PanelTemplate="{StaticResource PanelRowTemplate}"
                                       FilterTemplate="{StaticResource FilterRowTemplate}"/>
        </Grid.Resources>
        <!-- WinUI's ProcessCmdKey: accelerators attach declaratively to an element subtree. -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="Observation_Invoked"/>
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- toolbar: reload + summary -->
            <RowDefinition Height="Auto"/>  <!-- filter bar -->
            <RowDefinition Height="Auto"/>  <!-- column headers -->
            <RowDefinition Height="*"/>     <!-- grid -->
            <RowDefinition Height="Auto"/>  <!-- status bar -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <Button x:Name="ReloadButton" Content="Reload (rescan)" Click="Reload_Click"/>
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="22" Height="22"/>
            <TextBlock Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" VerticalAlignment="Center"
                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,10,0,8">
            <TextBox x:Name="SearchBox" PlaceholderText="search target / project / filter…"
                     Width="280" TextChanged="Search_TextChanged"/>
            <ComboBox x:Name="SourceFilter" SelectedIndex="0" Width="130"
                      SelectionChanged="SourceFilter_SelectionChanged">
                <ComboBoxItem Content="All sources"/>
                <ComboBoxItem Content="Both"/>
                <ComboBoxItem Content="TS-only"/>
                <ComboBoxItem Content="Disk-only"/>
            </ComboBox>
            <CheckBox x:Name="FlaggedOnly" Content="flagged only"
                      Checked="FlaggedOnly_Changed" Unchecked="FlaggedOnly_Changed"/>
            <ComboBox x:Name="SortPicker" SelectedIndex="0" Width="170"
                      SelectionChanged="Sort_SelectionChanged">
                <ComboBoxItem Content="Sort: target"/>
                <ComboBoxItem Content="Sort: remaining ↓"/>
                <ComboBoxItem Content="Sort: disk ↓"/>
                <ComboBoxItem Content="Sort: Δ ↓"/>
            </ComboBox>
            <Button Content="Expand all" Click="ExpandAll_Click"/>
            <Button Content="Collapse all" Click="CollapseAll_Click"/>
        </StackPanel>

        <!-- Header row mirrors the row template's column widths (WinUI's ListView has no built-in
             column headers — that's the DataGridView feature we're hand-rolling for M1). -->
        <Grid Grid.Row="2" Padding="12,0,12,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="45"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <!-- Column 0 header is blank: the enable checkboxes below it are self-evident. -->
            <TextBlock Grid.Column="1" Text="Source" Style="{ThemeResource CaptionTextBlockStyle}"/>
            <TextBlock Grid.Column="2" Text="Target" Style="{ThemeResource CaptionTextBlockStyle}"/>
            <TextBlock Grid.Column="3" Text="Project" Style="{ThemeResource CaptionTextBlockStyle}"/>
            <TextBlock Grid.Column="4" Text="Filter" Style="{ThemeResource CaptionTextBlockStyle}"/>
            <TextBlock Grid.Column="5" Text="Seconds" Style="{ThemeResource CaptionTextBlockStyle}" TextAlignment="Right" Margin="0,0,14,0"/>
            <TextBlock Grid.Column="6" Text="Purpose" Style="{ThemeResource CaptionTextBlockStyle}"/>
            <TextBlock Grid.Column="7" Text="Desired" Style="{ThemeResource CaptionTextBlockStyle}" TextAlignment="Right"/>
            <TextBlock Grid.Column="8" Text="Acq" Style="{ThemeResource CaptionTextBlockStyle}" TextAlignment="Right"/>
            <TextBlock Grid.Column="9" Text="Acc" Style="{ThemeResource CaptionTextBlockStyle}" TextAlignment="Right"/>
            <TextBlock Grid.Column="10" Text="Disk" Style="{ThemeResource CaptionTextBlockStyle}" TextAlignment="Right"/>
            <TextBlock Grid.Column="11" Text="Hours" Style="{ThemeResource CaptionTextBlockStyle}" TextAlignment="Right"/>
            <TextBlock Grid.Column="12" Text="Plans" Style="{ThemeResource CaptionTextBlockStyle}" TextAlignment="Right"/>
            <TextBlock Grid.Column="13" Text="Badges" Style="{ThemeResource CaptionTextBlockStyle}" Margin="10,0,0,0"/>
        </Grid>

        <!-- A flattened tree, not a real TreeView: the VM owns the visible-row list (group headers +
             expanded children), like a WinForms TreeListView in VirtualMode. Still fully virtualized.
             Clicking anywhere on a group row toggles it (ItemClick is a no-op on filter rows). -->
        <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                  ItemTemplateSelector="{StaticResource RowTemplateSelector}"
                  SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Row_ItemClick">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="30"/>
                    <Setter Property="Padding" Value="12,2,12,2"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <TextBlock Grid.Row="4" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                   Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7" Margin="0,6,0,0"/>
    </Grid>
</Window>
