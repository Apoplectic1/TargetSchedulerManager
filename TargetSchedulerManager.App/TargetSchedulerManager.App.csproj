<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Zero-warning ratchet (2026-08-01, portfolio-wide): a new warning is a build break. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <OutputType>WinExe</OutputType>
    <!-- WinUI needs a real Windows TargetPlatformVersion (unlike net10.0-windows = 7.0 in the library);
         19041 is the lowest TPV with the full WinUI 3 surface; min 17763 matches Windows App SDK support. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>TargetSchedulerManager.App</RootNamespace>
    <AssemblyName>tsmui</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Self-contained Windows App SDK (runtime ships in the output folder) needs a RID at build time;
         x64-only app, so pin it. The .NET runtime itself stays framework-dependent. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Unpackaged: builds a plain exe (run/F5 like a WinForms app), no MSIX. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Velopack owns the entry point: the generated Main is disabled and Program.cs runs
         VelopackApp first (install/update hooks must be serviced before any XAML exists). -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- MinVer derives the assembly version from the latest v-prefixed git tag (the same vX.Y.Z
         tags that gate main pushes — RELEASING.md). Untagged commits shape as alpha prereleases,
         which the updater's prerelease:false filter never offers to installed copies. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>alpha.0</MinVerDefaultPreReleaseIdentifiers>
    <!-- MinVer 7's build cache keys on the option list only, not the repo — in a build graph
         spanning two repos (this app + ..\Library via ProjectReference) identical options make
         the app inherit the Library's version (XFM shipped v2.1.0-v2.2.0 stamping AL's 1.5.x
         this way, 2026-08-06). An explicit verbosity (behavior-neutral) makes this project's
         cache key unique. Keep it DIFFERENT from any MinVerVerbosity the Library might set. -->
    <MinVerVerbosity>normal</MinVerVerbosity>
    <!-- Stamps the exe (Explorer/taskbar); the title bar itself needs the runtime
         AppWindow.SetIcon call in MainWindow, which reads the copied Content file below. -->
    <ApplicationIcon>Assets\app_icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\app_icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="MinVer" Version="7.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <!-- Cross-repo local ProjectReferences (local disk is source of truth): the shared schema/build contract,
       the shared diagnostics (Log + screen capture; brings System.Drawing.Common transitively), and the
       Meeus astronomy core (night window + visibility math for the Visible-tonight pass). -->
  <ItemGroup>
    <ProjectReference Include="..\..\Library\Astronomy.Catalog\Astronomy.Catalog.csproj" />
    <ProjectReference Include="..\..\Library\Astronomy.Diagnostics\Astronomy.Diagnostics.csproj" />
    <ProjectReference Include="..\..\Library\Astronomy.Core\Astronomy.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TargetSchedulerManager.App.Tests" />
  </ItemGroup>

</Project>
