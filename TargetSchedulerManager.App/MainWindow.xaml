<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TargetSchedulerManager.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TargetSchedulerManager.App"
    xmlns:m="using:TargetSchedulerManager.App.ViewModels.Rows">

    <!-- Layout = nested panels (like WinForms TableLayoutPanel/Dock) declared in XAML.
         {x:Bind} is typed, compile-time binding: a path typo is a build error, not a silent empty cell. -->
    <!-- PlacementMode Hidden: WinUI auto-surfaces a declared accelerator as a floating "Ctrl+N" hover
         tooltip; Hidden removes that hint entirely (never created) while the accelerator keeps working. -->
    <!-- Count columns: "Desired" = TS goal; "TS" = TS's recorded acquired (the number TS schedules on with the
         grader off); "Actual" = on-disk frames (ground truth). TS "accepted" is intentionally NOT a column — with
         grading off TS keeps accepted == acquired, and write-back re-sets them equal; a rare acc≠acq drift surfaces
         as a badge (see ReconciliationLoader) rather than a permanent column. The "TS" header doubles the token the
         Source column prints per row by design (user's call). -->
    <!-- Per-cell VerticalAlignment="Center" on every text cell (NOT a window-wide implicit TextBlock style — it
         applies unevenly in DataTemplates + leaks into controls). Rule + gotcha: DOMAIN.md. -->
    <Grid Padding="12,8,12,8" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.Resources>
            <!-- The grid's rows mix two item types (group header / filter row); the selector below picks the
                 template per item. Both templates share the header's column widths so everything lines up. -->
            <DataTemplate x:Key="GroupRowTemplate" x:DataType="m:TargetGroupRow">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="45"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <!-- Target enable (TS target.active): only on TS-backed target headers (CanEnableVisibility
                         hides it on disk-only and mosaic-parent rows). Click writes to the TS copy immediately. -->
                    <CheckBox Grid.Column="0" MinWidth="0" MinHeight="0" Padding="0" Margin="0"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Visibility="{x:Bind CanEnableVisibility}"
                              IsChecked="{x:Bind IsTargetEnabled}" IsThreeState="False"
                              Click="TargetEnable_Click"
                              ToolTipService.ToolTip="Enable/disable this target in Target Scheduler"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <!-- The disclosure chevron; OneWay because IsExpanded flips in place on toggle. -->
                        <FontIcon Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" FontSize="11"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind SourceText}" Opacity="0.7" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{x:Bind TargetText}" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="3" Text="{x:Bind Project}" Opacity="0.7"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="7" Text="{x:Bind DesiredText, Mode=OneWay}" TextAlignment="Right"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="8" Text="{x:Bind AcquiredText}" TextAlignment="Right" Opacity="0.7"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="9" Text="{x:Bind DiskText}" TextAlignment="Right" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <!-- Disk hours − desired hours; caution fill = needs telescope time, green = goal met. -->
                    <Border Grid.Column="10" Background="{x:Bind HoursBackground, Mode=OneWay}" CornerRadius="4"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Padding="6,1">
                        <TextBlock Text="{x:Bind HoursText, Mode=OneWay}"/>
                    </Border>
                    <TextBlock Grid.Column="12" Text="{x:Bind Badge}" Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource SystemFillColorCautionBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="FilterRowTemplate" x:DataType="m:ReconciliationRow">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="45"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <!-- Column 0 (enable checkbox) is blank on filter rows. Indent ladder: mixed rollups carry
                         their own chevron; their source lines step in one more level (SourceMargin all three). -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                Margin="{x:Bind SourceMargin}">
                        <FontIcon Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" FontSize="11"
                                  VerticalAlignment="Center" Visibility="{x:Bind ChevronVisibility}"/>
                        <TextBlock Text="{x:Bind SourceText}" Opacity="0.7" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{x:Bind Target}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="3" Text="{x:Bind Project}" Opacity="0.7"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="4" Text="{x:Bind Filter}" VerticalAlignment="Center"/>
                    <!-- "mixed" gets a caution pill when a rollup spans 2+ sub lengths; plain otherwise. -->
                    <Border Grid.Column="6" Background="{x:Bind SecondsBackground}" CornerRadius="4"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Padding="6,1" Margin="0,0,8,0">
                        <TextBlock Text="{x:Bind SecondsText}"/>
                    </Border>
                    <TextBlock Grid.Column="5" Text="{x:Bind Purpose}" Opacity="0.7" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="7" Text="{x:Bind DesiredText, Mode=OneWay}" TextAlignment="Right"
                               VerticalAlignment="Center" Visibility="{x:Bind DesiredTextVisibility}"/>
                    <!-- 1:1 plan row's desired, editable in place; focus-loss writes to TS. Width ~3 chars +
                         centered in code-behind (DesiredBox_Loaded) per the integer-edit-box rule —
                         see DOMAIN.md. Spin buttons hidden; write fires only on a real change. -->
                    <NumberBox Grid.Column="7" Value="{x:Bind DesiredValue}"
                               Visibility="{x:Bind DesiredEditVisibility}"
                               Minimum="0" SmallChange="1" LargeChange="10"
                               SpinButtonPlacementMode="Hidden"
                               MinWidth="0" Margin="0" Padding="2,2" VerticalAlignment="Center"
                               Width="40" HorizontalAlignment="Right" HorizontalContentAlignment="Stretch"
                               Loaded="DesiredBox_Loaded" LostFocus="Desired_Committed"/>
                    <TextBlock Grid.Column="8" Text="{x:Bind AcquiredText}" TextAlignment="Right" Opacity="0.7"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="9" Text="{x:Bind DiskText}" TextAlignment="Right"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <!-- One-plane rows: plain hours. Both rows: disk − desired gap, caution/green fill. -->
                    <Border Grid.Column="10" Background="{x:Bind HoursBackground, Mode=OneWay}" CornerRadius="4"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Padding="6,1">
                        <TextBlock Text="{x:Bind HoursText, Mode=OneWay}"/>
                    </Border>
                    <TextBlock Grid.Column="11" Text="{x:Bind PlanCountText}" TextAlignment="Right" Opacity="0.7"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="12" Text="{x:Bind Badge}" Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource SystemFillColorCautionBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </DataTemplate>
            <!-- A mosaic panel's mini-header: the group template's shape, indented one step, showing the
                 panel's own source/aggregates. Click toggles its filter rows like a target group. -->
            <DataTemplate x:Key="PanelRowTemplate" x:DataType="m:PanelGroupRow">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="45"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <!-- Column 0 (enable checkbox) is blank on panel rows; the 18px panel indent lives in column 1. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="18,0,0,0"
                                VerticalAlignment="Center">
                        <FontIcon Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" FontSize="11"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind SourceText}" Opacity="0.7" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{x:Bind Label}" Opacity="0.9"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="7" Text="{x:Bind DesiredText, Mode=OneWay}" TextAlignment="Right"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="8" Text="{x:Bind AcquiredText}" TextAlignment="Right" Opacity="0.7"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="9" Text="{x:Bind DiskText}" TextAlignment="Right" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Border Grid.Column="10" Background="{x:Bind HoursBackground, Mode=OneWay}" CornerRadius="4"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Padding="6,1">
                        <TextBlock Text="{x:Bind HoursText, Mode=OneWay}"/>
                    </Border>
                    <TextBlock Grid.Column="12" Text="{x:Bind Badge}" Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource SystemFillColorCautionBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </DataTemplate>
            <local:RowTemplateSelector x:Key="RowTemplateSelector"
                                       GroupTemplate="{StaticResource GroupRowTemplate}"
                                       PanelTemplate="{StaticResource PanelRowTemplate}"
                                       FilterTemplate="{StaticResource FilterRowTemplate}"/>
        </Grid.Resources>
        <!-- WinUI's ProcessCmdKey: accelerators attach declaratively to an element subtree. -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="Diagnostics_Invoked"/>
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- toolbar: reload + summary -->
            <RowDefinition Height="Auto"/>  <!-- filter bar -->
            <RowDefinition Height="Auto"/>  <!-- column headers -->
            <RowDefinition Height="*"/>     <!-- grid -->
            <RowDefinition Height="Auto"/>  <!-- status bar -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <Button x:Name="ReloadButton" Content="Reload (rescan)" Click="Reload_Click"/>
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="22" Height="22"/>
            <!-- TS source: edit the LIVE BIRDWATCHER db (caution-colored — writes hit the rig) or the LOCAL copy.
                 LIVE greys out for the session if BIRDWATCHER is unreachable (re-launch TSM to retry). Switching
                 reloads from the chosen db. -->
            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                        ToolTipService.ToolTip="{x:Bind ViewModel.TsSourceTooltip, Mode=OneWay}">
                <RadioButton Content="LIVE — BIRDWATCHER" GroupName="TsSource" MinWidth="0"
                             Foreground="{ThemeResource SystemFillColorCautionBrush}" FontWeight="SemiBold"
                             IsEnabled="{x:Bind ViewModel.LiveEnabled, Mode=OneWay}"
                             IsChecked="{x:Bind ViewModel.IsLiveSelected, Mode=OneWay}" Checked="Live_Checked"/>
                <RadioButton Content="LOCAL copy" GroupName="TsSource" MinWidth="0" Opacity="0.85"
                             IsChecked="{x:Bind ViewModel.IsLocalSelected, Mode=OneWay}" Checked="Local_Checked"/>
            </StackPanel>
            <TextBlock Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" VerticalAlignment="Center"
                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,10,0,8">
            <TextBox x:Name="SearchBox" PlaceholderText="search target / project / filter…"
                     Width="280" TextChanged="Search_TextChanged"/>
            <ComboBox x:Name="SourceFilter" SelectedIndex="0" Width="130"
                      SelectionChanged="SourceFilter_SelectionChanged">
                <ComboBoxItem Content="All sources"/>
                <ComboBoxItem Content="Both"/>
                <ComboBoxItem Content="TS-only"/>
                <ComboBoxItem Content="Disk-only"/>
            </ComboBox>
            <CheckBox x:Name="FlaggedOnly" Content="flagged only"
                      Checked="FlaggedOnly_Changed" Unchecked="FlaggedOnly_Changed"/>
            <ComboBox x:Name="SortPicker" SelectedIndex="0" Width="170"
                      SelectionChanged="Sort_SelectionChanged">
                <ComboBoxItem Content="Sort: target"/>
                <ComboBoxItem Content="Sort: remaining ↓"/>
                <ComboBoxItem Content="Sort: disk ↓"/>
                <ComboBoxItem Content="Sort: Δ ↓"/>
            </ComboBox>
            <Button Content="Expand all" Click="ExpandAll_Click"/>
            <Button Content="Collapse all" Click="CollapseAll_Click"/>
        </StackPanel>

        <!-- Header row mirrors the row template's column widths (WinUI's ListView has no built-in
             column headers — that's the DataGridView feature we're hand-rolling for M1). -->
        <Grid Grid.Row="2" Padding="12,0,12,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="88"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="45"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <!-- Column 0 header is blank: the enable checkboxes below it are self-evident. -->
            <TextBlock Grid.Column="1" Text="Source" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="Target" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="3" Text="Project" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="4" Text="Filter" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="6" Text="Seconds" Style="{ThemeResource CaptionTextBlockStyle}" TextAlignment="Right" Margin="0,0,14,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="5" Text="Purpose" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="7" Text="Desired" Style="{ThemeResource CaptionTextBlockStyle}" TextAlignment="Right" VerticalAlignment="Center"/>
            <!-- "TS" = TS's recorded acquired (what it schedules on); "Actual" = on-disk frames. "Acc" (accepted)
                 is not shown — see the count-columns note at the top of this file. -->
            <TextBlock Grid.Column="8" Text="TS" Style="{ThemeResource CaptionTextBlockStyle}" TextAlignment="Right" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="9" Text="Actual" Style="{ThemeResource CaptionTextBlockStyle}" TextAlignment="Right" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="10" Text="Hours" Style="{ThemeResource CaptionTextBlockStyle}" TextAlignment="Right" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="11" Text="Plans" Style="{ThemeResource CaptionTextBlockStyle}" TextAlignment="Right" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="12" Text="Badges" Style="{ThemeResource CaptionTextBlockStyle}" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </Grid>

        <!-- A flattened tree, not a real TreeView: the VM owns the visible-row list (group headers +
             expanded children), like a WinForms TreeListView in VirtualMode. Still fully virtualized.
             Clicking anywhere on a group row toggles it (ItemClick is a no-op on filter rows). -->
        <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                  ItemTemplateSelector="{StaticResource RowTemplateSelector}"
                  SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Row_ItemClick">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="30"/>
                    <Setter Property="Padding" Value="12,2,12,2"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <TextBlock Grid.Row="4" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                   Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7" Margin="0,6,0,0"
                   VerticalAlignment="Center"/>
    </Grid>
</Window>
