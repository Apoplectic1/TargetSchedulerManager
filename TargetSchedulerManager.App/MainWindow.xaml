<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TargetSchedulerManager.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TargetSchedulerManager.App"
    xmlns:controls="using:TargetSchedulerManager.App.Controls"
    xmlns:m="using:TargetSchedulerManager.App.ViewModels.Rows">

    <!-- Layout = nested panels (like WinForms TableLayoutPanel/Dock) declared in XAML.
         {x:Bind} is typed, compile-time binding: a path typo is a build error, not a silent empty cell. -->
    <!-- PlacementMode Hidden: WinUI auto-surfaces a declared accelerator as a floating "Ctrl+N" hover
         tooltip; Hidden removes that hint entirely (never created) while the accelerator keeps working. -->
    <!-- Count columns: "Desired" = TS goal; "TS" = TS's recorded acquired (the number TS schedules on with the
         grader off); "Actual" = on-disk frames (ground truth). TS "accepted" is intentionally NOT a column — with
         grading off TS keeps accepted == acquired, and write-back re-sets them equal; a rare acc≠acq drift surfaces
         as a badge (see ReconciliationLoader) rather than a permanent column. The "TS" header doubles the token the
         Source column prints per row by design (user's call). -->
    <!-- Per-cell VerticalAlignment="Center" on every text cell (NOT a window-wide implicit TextBlock style — it
         applies unevenly in DataTemplates + leaks into controls). Rule + gotcha: DOMAIN.md. -->
    <!-- Column 0 on every row level: the sync-direction mark — arrow-left = arrived changed from BIRDWATCHER
         (pull-time diff, sticky for the session), arrow-right = unpushed local writes (the journal), both-arrows
         = both directions pending. Resolved by Services\SyncMarks; refreshed in place by RefreshAllMarks. -->
    <Grid Padding="12,8,12,8" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.Resources>
            <!-- The grid's rows mix two item types (group header / filter row); the selector below picks the
                 template per item. Both templates share the header's column widths so everything lines up. -->
            <DataTemplate x:Key="GroupRowTemplate" x:DataType="m:TargetGroupRow">
                <!-- Transparent background so empty cells hit-test: the hover handlers reveal the edit glyph. -->
                <Grid Background="Transparent" local:GridColumns.ApplyRuler="True"
                      PointerEntered="Row_PointerEntered" PointerExited="Row_PointerExited">
                    <!-- Column 0: the sync-direction mark, rolled up over the subtree (arrow left = arrived
                         changed from BIRDWATCHER, arrow right = unpushed local writes, both = both directions);
                         tooltip carries the direction counts. Updated in place by the marks sweep. -->
                    <TextBlock Grid.Column="0" Text="{x:Bind MarkGlyph, Mode=OneWay}" TextAlignment="Center"
                               VerticalAlignment="Center"
                               ToolTipService.ToolTip="{x:Bind MarkTooltip, Mode=OneWay}"/>
                    <!-- Target enable (TS target.active): only on TS-backed target headers (CanEnableVisibility
                         hides it on disk-only and mosaic-parent rows). Click writes to the TS copy immediately. -->
                    <CheckBox Grid.Column="1" MinWidth="0" MinHeight="0" Padding="0" Margin="0"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Visibility="{x:Bind CanEnableVisibility}"
                              IsChecked="{x:Bind IsTargetEnabled, Mode=OneWay}" IsThreeState="False"
                              Click="TargetEnable_Click"
                              ToolTipService.ToolTip="Enable/disable this target in Target Scheduler"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <!-- The disclosure chevron; OneWay because IsExpanded flips in place on toggle. -->
                        <FontIcon Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" FontSize="11"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind SourceText}" Opacity="0.7" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind TargetText}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <!-- Hover-revealed edit glyph (Opacity flips in Row_PointerEntered/Exited); TS-backed
                             groups only. Normal group → target flyout; mosaic parent → mosaic-project flyout
                             (master enable + project priority). Swallows the click so whole-row expand
                             doesn't also fire. -->
                        <Button x:Name="EditGlyph" Opacity="0" Visibility="{x:Bind EditGlyphVisibility}"
                                Background="Transparent" BorderThickness="0"
                                MinWidth="0" MinHeight="0" Padding="3,1" VerticalAlignment="Center"
                                Click="EditTarget_Click"
                                ToolTipService.ToolTip="{x:Bind EditTooltip}">
                            <FontIcon Glyph="&#xE70F;" FontSize="12"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Grid.Column="4" Text="{x:Bind Project}" Opacity="0.7"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <!-- Capture configuration rolled up over the subtree: the shared value, or a "mixed"
                         caution pill naming the dimension whose children disagree — readable BEFORE expanding. -->
                    <Border Grid.Column="5" Background="{x:Bind CameraBackground, Mode=OneWay}" CornerRadius="4"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Padding="6,1">
                        <TextBlock Text="{x:Bind CameraText, Mode=OneWay}"/>
                    </Border>
                    <Border Grid.Column="6" Background="{x:Bind GainBackground, Mode=OneWay}" CornerRadius="4"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Padding="6,1">
                        <TextBlock Text="{x:Bind GainText, Mode=OneWay}"/>
                    </Border>
                    <Border Grid.Column="7" Background="{x:Bind OffsetBackground, Mode=OneWay}" CornerRadius="4"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Padding="6,1">
                        <TextBlock Text="{x:Bind OffsetText, Mode=OneWay}"/>
                    </Border>
                    <Border Grid.Column="8" Background="{x:Bind BinBackground, Mode=OneWay}" CornerRadius="4"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Padding="6,1">
                        <TextBlock Text="{x:Bind BinText, Mode=OneWay}"/>
                    </Border>
                    <TextBlock Grid.Column="12" Text="{x:Bind DesiredText, Mode=OneWay}" TextAlignment="Right"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="13" Text="{x:Bind AcquiredText}" TextAlignment="Right" Opacity="0.7"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="14" Text="{x:Bind DiskText}" TextAlignment="Right" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <!-- Disk hours − desired hours; caution fill = needs telescope time, green = goal met. -->
                    <Border Grid.Column="15" Background="{x:Bind HoursBackground, Mode=OneWay}" CornerRadius="4"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Padding="6,1">
                        <TextBlock Text="{x:Bind HoursText, Mode=OneWay}"/>
                    </Border>
                    <!-- Per-token severity colour (warning amber vs. quiet informative) — BadgeRuns fills the
                         Inlines; one TextBlock so the 150px column keeps ellipsis trimming. -->
                    <TextBlock Grid.Column="17" controls:BadgeRuns.Tokens="{x:Bind Badge}" Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="FilterRowTemplate" x:DataType="m:ReconciliationRow">
                <!-- Transparent background so empty cells hit-test: the hover handlers reveal the edit glyph. -->
                <Grid Background="Transparent" local:GridColumns.ApplyRuler="True"
                      PointerEntered="Row_PointerEntered" PointerExited="Row_PointerExited">
                    <!-- Column 0: this plan's sync-direction mark (per-field old→new lines in the tooltip);
                         blank on disk-plane rows (no plan key) — target/project changes mark the header. -->
                    <TextBlock Grid.Column="0" Text="{x:Bind MarkGlyph, Mode=OneWay}" TextAlignment="Center"
                               VerticalAlignment="Center"
                               ToolTipService.ToolTip="{x:Bind MarkTooltip, Mode=OneWay}"/>
                    <!-- Column 1: per-plan enable (exposureplan.enabled) on 1:1 TS plan rows only — cadence-
                         breaking, so the click confirms first (PlanEnable_Click). Indent ladder: mixed rollups
                         carry their own chevron; their source lines step in one more level (SourceMargin). -->
                    <CheckBox Grid.Column="1" MinWidth="0" MinHeight="0" Padding="0" Margin="0"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Visibility="{x:Bind PlanEnableVisibility}"
                              IsChecked="{x:Bind IsPlanEnabled, Mode=OneWay}" IsThreeState="False"
                              Click="PlanEnable_Click"
                              ToolTipService.ToolTip="Enable/disable this exposure plan (resets the target's TS filter cadence — the shoot-next order, not the rotation angle)"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                Margin="{x:Bind SourceMargin}">
                        <FontIcon Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" FontSize="11"
                                  VerticalAlignment="Center" Visibility="{x:Bind ChevronVisibility}"/>
                        <TextBlock Text="{x:Bind SourceText}" Opacity="0.7" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{x:Bind Target}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="4" Text="{x:Bind Project}" Opacity="0.7"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <!-- Capture configuration: the reason this row stands apart from its siblings. Gain/Offset/
                         Bin are reconciliation keys, so a row that separated always shows what separated it;
                         a rollup shows "mixed" where its source lines disagree. Camera is disk-side only — a
                         TS plan cannot name one, so a TS row shows the dash. -->
                    <Border Grid.Column="5" Background="{x:Bind CameraBackground}" CornerRadius="4"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Padding="6,1">
                        <TextBlock Text="{x:Bind CameraText}"/>
                    </Border>
                    <Border Grid.Column="6" Background="{x:Bind GainBackground}" CornerRadius="4"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Padding="6,1">
                        <TextBlock Text="{x:Bind GainText}"/>
                    </Border>
                    <Border Grid.Column="7" Background="{x:Bind OffsetBackground}" CornerRadius="4"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Padding="6,1">
                        <TextBlock Text="{x:Bind OffsetText}"/>
                    </Border>
                    <Border Grid.Column="8" Background="{x:Bind BinBackground}" CornerRadius="4"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Padding="6,1">
                        <TextBlock Text="{x:Bind BinText}"/>
                    </Border>
                    <StackPanel Grid.Column="9" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Filter}" VerticalAlignment="Center"/>
                        <!-- Hover-revealed edit glyph; only on 1:1 TS plan rows (PlanTsKey). Opens the
                             exposure-plan edit flyout. -->
                        <Button x:Name="EditGlyph" Opacity="0" Visibility="{x:Bind EditGlyphVisibility}"
                                Background="Transparent" BorderThickness="0"
                                MinWidth="0" MinHeight="0" Padding="3,1" VerticalAlignment="Center"
                                Click="EditPlan_Click"
                                ToolTipService.ToolTip="Edit exposure plan…">
                            <FontIcon Glyph="&#xE70F;" FontSize="12"/>
                        </Button>
                    </StackPanel>
                    <!-- "mixed" gets a caution pill when a rollup spans 2+ sub lengths; plain otherwise.
                         SecondsText is OneWay (x:Bind defaults to OneTime): an in-place exposure mirror
                         (ApplyPlanSeconds) must repaint the cell. -->
                    <Border Grid.Column="11" Background="{x:Bind SecondsBackground}" CornerRadius="4"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Padding="6,1" Margin="0,0,8,0">
                        <TextBlock Text="{x:Bind SecondsText, Mode=OneWay}"/>
                    </Border>
                    <TextBlock Grid.Column="10" Text="{x:Bind Purpose}" Opacity="0.7" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="12" Text="{x:Bind DesiredText, Mode=OneWay}" TextAlignment="Right"
                               VerticalAlignment="Center" Visibility="{x:Bind DesiredTextVisibility}"/>
                    <!-- 1:1 plan row's desired, editable in place; focus-loss writes to TS. Width ~3 chars +
                         centered in code-behind (NarrowNumberBox_Loaded) per the integer-edit-box rule —
                         see DOMAIN.md. Spin buttons hidden; write fires only on a real change. -->
                    <NumberBox Grid.Column="12" Value="{x:Bind DesiredValue}"
                               Visibility="{x:Bind DesiredEditVisibility}"
                               Minimum="0" SmallChange="1" LargeChange="10"
                               SpinButtonPlacementMode="Hidden"
                               MinWidth="0" Margin="0" Padding="2,2" VerticalAlignment="Center"
                               Width="40" HorizontalAlignment="Right" HorizontalContentAlignment="Stretch"
                               Loaded="NarrowNumberBox_Loaded" LostFocus="Desired_Committed"/>
                    <TextBlock Grid.Column="13" Text="{x:Bind AcquiredText}" TextAlignment="Right" Opacity="0.7"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="14" Text="{x:Bind DiskText}" TextAlignment="Right"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <!-- One-plane rows: plain hours. Both rows: disk − desired gap, caution/green fill. -->
                    <Border Grid.Column="15" Background="{x:Bind HoursBackground, Mode=OneWay}" CornerRadius="4"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Padding="6,1">
                        <TextBlock Text="{x:Bind HoursText, Mode=OneWay}"/>
                    </Border>
                    <TextBlock Grid.Column="16" Text="{x:Bind PlanCountText}" TextAlignment="Right" Opacity="0.7"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="17" controls:BadgeRuns.Tokens="{x:Bind Badge}" Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </DataTemplate>
            <!-- A mosaic panel's mini-header: the group template's shape, indented one step, showing the
                 panel's own source/aggregates. Click toggles its filter rows like a target group. -->
            <DataTemplate x:Key="PanelRowTemplate" x:DataType="m:PanelGroupRow">
                <!-- Transparent background so empty cells hit-test: the hover handlers reveal the edit glyph. -->
                <Grid Background="Transparent" local:GridColumns.ApplyRuler="True"
                      PointerEntered="Row_PointerEntered" PointerExited="Row_PointerExited">
                    <!-- Column 0: the panel's rolled-up sync-direction mark (its own target + plans only —
                         a mosaic project edit marks the parent, never panels). -->
                    <TextBlock Grid.Column="0" Text="{x:Bind MarkGlyph, Mode=OneWay}" TextAlignment="Center"
                               VerticalAlignment="Center"
                               ToolTipService.ToolTip="{x:Bind MarkTooltip, Mode=OneWay}"/>
                    <!-- Column 1 (enable checkbox) is blank on panel rows; the 18px panel indent lives in column 2. -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="18,0,0,0"
                                VerticalAlignment="Center">
                        <FontIcon Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" FontSize="11"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind SourceText}" Opacity="0.7" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Label}" Opacity="0.9"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <!-- A panel IS a normal TS target — standard target flyout, hover-revealed glyph. -->
                        <Button x:Name="EditGlyph" Opacity="0" Visibility="{x:Bind EditGlyphVisibility}"
                                Background="Transparent" BorderThickness="0"
                                MinWidth="0" MinHeight="0" Padding="3,1" VerticalAlignment="Center"
                                Click="EditPanelTarget_Click"
                                ToolTipService.ToolTip="Edit panel target…">
                            <FontIcon Glyph="&#xE70F;" FontSize="12"/>
                        </Button>
                    </StackPanel>
                    <!-- Panel-level rollup of the capture configuration, same idiom as the target header. -->
                    <Border Grid.Column="5" Background="{x:Bind CameraBackground, Mode=OneWay}" CornerRadius="4"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Padding="6,1">
                        <TextBlock Text="{x:Bind CameraText, Mode=OneWay}"/>
                    </Border>
                    <Border Grid.Column="6" Background="{x:Bind GainBackground, Mode=OneWay}" CornerRadius="4"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Padding="6,1">
                        <TextBlock Text="{x:Bind GainText, Mode=OneWay}"/>
                    </Border>
                    <Border Grid.Column="7" Background="{x:Bind OffsetBackground, Mode=OneWay}" CornerRadius="4"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Padding="6,1">
                        <TextBlock Text="{x:Bind OffsetText, Mode=OneWay}"/>
                    </Border>
                    <Border Grid.Column="8" Background="{x:Bind BinBackground, Mode=OneWay}" CornerRadius="4"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Padding="6,1">
                        <TextBlock Text="{x:Bind BinText, Mode=OneWay}"/>
                    </Border>
                    <TextBlock Grid.Column="12" Text="{x:Bind DesiredText, Mode=OneWay}" TextAlignment="Right"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="13" Text="{x:Bind AcquiredText}" TextAlignment="Right" Opacity="0.7"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="14" Text="{x:Bind DiskText}" TextAlignment="Right" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Border Grid.Column="15" Background="{x:Bind HoursBackground, Mode=OneWay}" CornerRadius="4"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Padding="6,1">
                        <TextBlock Text="{x:Bind HoursText, Mode=OneWay}"/>
                    </Border>
                    <TextBlock Grid.Column="17" controls:BadgeRuns.Tokens="{x:Bind Badge}" Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </DataTemplate>
            <local:RowTemplateSelector x:Key="RowTemplateSelector"
                                       GroupTemplate="{StaticResource GroupRowTemplate}"
                                       PanelTemplate="{StaticResource PanelRowTemplate}"
                                       FilterTemplate="{StaticResource FilterRowTemplate}"/>
        </Grid.Resources>
        <!-- WinUI's ProcessCmdKey: accelerators attach declaratively to an element subtree. -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="Diagnostics_Invoked"/>
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- toolbar: reload + summary -->
            <RowDefinition Height="Auto"/>  <!-- filter bar -->
            <RowDefinition Height="Auto"/>  <!-- column headers -->
            <RowDefinition Height="*"/>     <!-- grid -->
            <RowDefinition Height="Auto"/>  <!-- status bar -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <!-- Busy-sensitive actions disable off CanEdit (openspec busy-exclusion): the VM funnel refuses
                 anyway — these bindings are the visible half. Cancel, search, filters, and
                 Ambiguities… (read-only) deliberately stay enabled. -->
            <Button x:Name="ReloadButton" Content="Reload (rescan)" Click="Reload_Click"
                    IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                    ToolTipService.ToolTip="Rescan the disk library + re-read the local TS copy (no pull)"/>
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="22" Height="22"/>
            <!-- Pull progress is a text percentage on the status line (no progress-bar element — user's
                 call); this cancel is the cooperative alternative to the process kill that tore the local
                 copy on 2026-07-23. Visible while any cancellable phase runs — pull, scan, or resolve — and
                 it cancels whichever one is in flight (cancelling a pull still lets the load continue on the
                 intact local copy; cancelling the scan/resolve ends the load, keeping the previous rows). -->
            <Button Content="Cancel" Click="CancelLoad_Click" MinWidth="0"
                    Visibility="{x:Bind ViewModel.IsCancellable, Mode=OneWay}"
                    ToolTipService.ToolTip="Stop whatever is running — the copy from BIRDWATCHER, or the disk scan / resolve. Nothing is left half-applied: the previous local copy and the current grid stay untouched (push writes are never interrupted)"/>
            <!-- Sync model: all edits land in the LOCAL copy and journal; BIRDWATCHER is read at pull (open /
                 Pull now) and written only by the reviewed Push. The badge displays the sync facts — last
                 synced time + unpushed count — so state is never something the user must remember. -->
            <TextBlock Text="{x:Bind ViewModel.SyncBadgeText, Mode=OneWay}" VerticalAlignment="Center"
                       FontWeight="SemiBold" Opacity="0.9"
                       ToolTipService.ToolTip="{x:Bind ViewModel.SyncTooltip, Mode=OneWay}"/>
            <Button Content="Push…" Click="Push_Click" MinWidth="0"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}" FontWeight="SemiBold"
                    IsEnabled="{x:Bind ViewModel.CanPush, Mode=OneWay}"
                    ToolTipService.ToolTip="Review + replay the journaled edits onto BIRDWATCHER (only edited fields are written)"/>
            <Button Content="Pull now" Click="PullNow_Click" MinWidth="0" Opacity="0.85"
                    IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                    ToolTipService.ToolTip="Force a fresh copy from BIRDWATCHER (unpushed edits prompt first)"/>
            <!-- Templates have no grid rows (they're shared config), so the picker is the app-level entry;
                 plan rows also offer "Edit template…" for the template behind that plan. -->
            <Button Content="Templates…" Click="Templates_Click" MinWidth="0" Opacity="0.85"
                    IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                    ToolTipService.ToolTip="Edit an exposure template (shared — an edit affects every plan using it)"/>
            <!-- The tripwire's detail (decision 2026-07-08): a printable report of every TS/disk ambiguity
                 with its hand-fix; TSM detects, edits happen in NINA's TS UI. -->
            <Button Content="Ambiguities…" Click="Ambiguities_Click" MinWidth="0" Opacity="0.85"
                    IsEnabled="{x:Bind ViewModel.CanShowAmbiguities, Mode=OneWay}"
                    ToolTipService.ToolTip="Write + open a printable report of TS/disk ambiguities (what · why · the hand fix in the TS UI)"/>
            <!-- One press, no confirm (user decision): target.active tracks tonight's sky (a single window
                 of ≥ Duration minutes above Floor degrees altitude), project.state follows its targets;
                 Draft/Closed untouched. Flips are ordinary journaled edits — push stays optional.
                 Both knobs default 30 (user decision 2026-07-23). UpDownBox is our own WinForms-style
                 NumericUpDown (Controls/UpDownBox.cs) — a narrow inline NumberBox is unreachables
                 (three hard-coded template widths; see DOMAIN.md → WinUI gotchas). It commits typed text
                 on focus loss/Enter and clamps to range, so a click on Tonight (which steals focus)1
                 always reads a valid whole number. Set Minimum/Maximum before Value (setter clamps). -->
            <TextBlock Text="Visible Tonight:" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBlock Text="Duration:" VerticalAlignment="Center" Opacity="0.85" Margin="0,0,-6,0"/>
            <controls:UpDownBox x:Name="VisibleDuration" Minimum="15" Maximum="480" SmallChange="15"
                                Value="30" Width="60" VerticalAlignment="Center"
                                ToolTipService.ToolTip="Shortest single stretch above the Floor (minutes, 15–480) that counts as visible tonight"/>
            <TextBlock Text="Floor:" VerticalAlignment="Center" Opacity="0.85" Margin="0,0,-6,0"/>
            <controls:UpDownBox x:Name="VisibleFloor" Minimum="0" Maximum="89" SmallChange="1"
                                Value="30" Width="52" VerticalAlignment="Center"
                                ToolTipService.ToolTip="Altitude floor (whole degrees, 0–89): the target must climb above this to count as visible"/>
            <Button Content="Tonight" Click="VisibleTonight_Click" MinWidth="0"
                    IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                    ToolTipService.ToolTip="Enable targets with a ≥ Duration-minute stretch above the Floor tonight, disable the rest; a project with no enabled targets goes Inactive (Draft/Closed skipped)"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,10,0,8">
            <TextBox x:Name="SearchBox" PlaceholderText="search target / project / filter…"
                     Width="280" TextChanged="Search_TextChanged"/>
            <ComboBox x:Name="SourceFilter" SelectedIndex="0" Width="130"
                      SelectionChanged="SourceFilter_SelectionChanged">
                <ComboBoxItem Content="All sources"/>
                <ComboBoxItem Content="Both"/>
                <ComboBoxItem Content="TS-only"/>
                <ComboBoxItem Content="Disk-only"/>
            </ComboBox>
            <CheckBox x:Name="FlaggedOnly" Content="flagged only"
                      Checked="FlaggedOnly_Changed" Unchecked="FlaggedOnly_Changed"/>
            <ComboBox x:Name="SortPicker" SelectedIndex="0" Width="170"
                      SelectionChanged="Sort_SelectionChanged">
                <ComboBoxItem Content="Sort: target"/>
                <ComboBoxItem Content="Sort: remaining ↓"/>
                <ComboBoxItem Content="Sort: disk ↓"/>
                <ComboBoxItem Content="Sort: Δ ↓"/>
            </ComboBox>
            <Button Content="Expand all" Click="ExpandAll_Click"/>
            <Button Content="Collapse all" Click="CollapseAll_Click"/>
        </StackPanel>

        <!-- Header row shares the row templates' column geometry BY CONSTRUCTION: header + all three row
             templates stamp their ColumnDefinitions from the one GridColumns ruler (WinUI's ListView has
             no built-in column headers — that's the DataGridView feature we're hand-rolling). -->
        <Grid Grid.Row="2" Padding="12,0,12,4" local:GridColumns.ApplyRuler="True">
            <!-- Columns 0–1 headers are blank: 0 is the sync-direction mark (its tooltip explains itself),
                 1 the enable checkboxes — both self-evident. -->
            <TextBlock Grid.Column="2" Text="Source" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="3" Text="Target" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="4" Text="Project" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center"/>
            <!-- Capture configuration. Gain/Offset/Bin are reconciliation keys (rows separate on them);
                 Camera is disk-side only. All four are excluded from sort precedence despite sitting here —
                 see ReconciliationLoader's sort comment. -->
            <TextBlock Grid.Column="5" Text="Camera" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="6" Text="Gain" Style="{ThemeResource CaptionTextBlockStyle}" TextAlignment="Right" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="7" Text="Offset" Style="{ThemeResource CaptionTextBlockStyle}" TextAlignment="Right" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="8" Text="Bin" Style="{ThemeResource CaptionTextBlockStyle}" TextAlignment="Right" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="9" Text="Filter" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="11" Text="Seconds" Style="{ThemeResource CaptionTextBlockStyle}" TextAlignment="Right" Margin="0,0,14,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="10" Text="Purpose" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="12" Text="Desired" Style="{ThemeResource CaptionTextBlockStyle}" TextAlignment="Right" VerticalAlignment="Center"/>
            <!-- "TS" = TS's recorded acquired (what it schedules on); "Actual" = on-disk frames. "Acc" (accepted)
                 is not shown — see the count-columns note at the top of this file. -->
            <TextBlock Grid.Column="13" Text="TS" Style="{ThemeResource CaptionTextBlockStyle}" TextAlignment="Right" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="14" Text="Actual" Style="{ThemeResource CaptionTextBlockStyle}" TextAlignment="Right" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="15" Text="Hours" Style="{ThemeResource CaptionTextBlockStyle}" TextAlignment="Right" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="16" Text="Plans" Style="{ThemeResource CaptionTextBlockStyle}" TextAlignment="Right" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="17" Text="Badges" Style="{ThemeResource CaptionTextBlockStyle}" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </Grid>

        <!-- A flattened tree, not a real TreeView: the VM owns the visible-row list (group headers +
             expanded children), like a WinForms TreeListView in VirtualMode. Still fully virtualized.
             Clicking anywhere on a group row toggles it (ItemClick is a no-op on filter rows). -->
        <!-- Whole-grid disable while busy: row controls live in DataTemplates where x:Bind scopes to the
             row, so CanEdit gates here (one binding) rather than per control. Scroll/expansion freeze for
             the seconds a bulk operation runs — accepted; revisit per-row only if it grates. -->
        <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                  ItemTemplateSelector="{StaticResource RowTemplateSelector}"
                  IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                  SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Row_ItemClick"
                  RightTapped="Row_RightTapped">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="30"/>
                    <Setter Property="Padding" Value="12,2,12,2"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <TextBlock Grid.Row="4" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                   Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7" Margin="0,6,0,0"
                   VerticalAlignment="Center"/>
    </Grid>
</Window>
