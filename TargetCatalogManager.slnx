<Solution>
  <!-- Pin the solution to x64 only: TCM is x64-only and the AL libraries support x64 (they keep AnyCPU as well for
       standalone `dotnet build <csproj>`). Without this block VS auto-derives an "Any CPU" platform from the AL
       libraries that x64-only TCM can't map to. -->
  <Configurations>
    <Platform Name="x64" />
  </Configurations>
  <Project Path="../Library/Astronomy.Catalog/Astronomy.Catalog.csproj">
    <Platform Solution="Debug|*" Project="x64" />
  </Project>
  <Project Path="../Library/Astronomy.XISF/Astronomy.XISF.csproj">
    <Platform Solution="Debug|*" Project="x64" />
  </Project>
  <Project Path="TargetCatalogManager.csproj" />
  <Project Path="TargetCatalogManager.App/TargetCatalogManager.App.csproj" />
</Solution>
